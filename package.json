{
  "name": "notehaven",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace=notehaven-frontend",
    "dev:backend": "npm run dev --workspace=notehaven-backend",
    "build": "npm run build --workspace=notehaven-frontend",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run start --workspace=notehaven-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
